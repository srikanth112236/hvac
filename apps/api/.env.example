# Copy to .env for your platform or export these variables before starting.
# The API does not load .env automatically; set them in the process environment.

NODE_ENV=development
PORT=4000

# Required in production -------------------------------------------------------
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-12-chars-min
ALLOWED_ORIGINS=http://127.0.0.1:5175
DATA_ENCRYPTION_KEY=32-character-minimum-key-keep-it-safe
PUBLIC_SITE_URL=http://127.0.0.1:5175

# Email: set one provider. Production portal registration requires this.
RESEND_API_KEY=
# or
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM="Coolvane HVAC <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=desk@example.com

# Operations
BUSINESS_TIMEZONE=America/Chicago
AUDIT_RETENTION_DAYS=365
EMAIL_LOG_RETENTION_DAYS=180
UPLOAD_ROOT=
