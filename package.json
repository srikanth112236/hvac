{
  "name": "coolvane-hvac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "White-label HVAC website + operations platform (Coolvane demo brand)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev -w @hvac/web",
    "dev:api": "npm run dev -w @hvac/api",
    "build": "npm run build -w @hvac/web",
    "build:client": "npm run build:client -w @hvac/web",
    "build:server": "npm run build:server -w @hvac/web",
    "build:prerender": "npm run build:prerender -w @hvac/web",
    "preview": "npm run preview -w @hvac/web",
    "serve:web": "npm run serve -w @hvac/web",
    "typecheck": "npm run typecheck -w @hvac/web && npm run typecheck -w @hvac/api",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "test": "npm run test -w @hvac/api",
    "test:ssr": "npm run test:ssr -w @hvac/web",
    "test:e2e": "playwright test",
    "seed:demo": "npm run seed:demo -w @hvac/api",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit",
    "format": "prettier --write .",
    "setup:hooks": "husky",
    "catalog:industries": "node scripts/generate-industry-catalog.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
